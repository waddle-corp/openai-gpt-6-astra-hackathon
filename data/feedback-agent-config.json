{
  "name": "boosted-feedback-improvement-agent",
  "model": "gpt-6-astra",
  "goal": "Increase average order value by helping shoppers confidently buy the right Boosted USA product and the parts that go with it.",
  "gating": {
    "requiredBeforeComputerUse": true,
    "decisions": [
      "fit",
      "review",
      "reject"
    ],
    "fitThreshold": 70
  },
  "computerUsePolicy": {
    "mode": "research-and-propose",
    "canDeploy": false,
    "canSubmitForms": false,
    "canChangeOrdersOrPayments": false,
    "requiresIsolatedBrowser": true
  },
  "feedbackSource": "data/shopper-feedback.json"
}
